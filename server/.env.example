PORT=5000
CLIENT_URL=http://localhost:5173
DATABASE_URL=postgresql://postgres:password@localhost:5432/got_next
JWT_SECRET=change_this_to_a_long_random_secret_string_in_production
NODE_ENV=development

# Queue expiry in hours (default 2)
QUEUE_EXPIRY_HOURS=2

# Twilio (optional — OTP is logged to console in dev mode if these are missing)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
